{
  "name": "Diarium",
  "displayName": "Diarium",
  "description": "Record work time and export local timesheet reports.",
  "version": "0.1.4",
  "publisher": "ferraria",
  "repository": {
    "type": "git",
    "url": "https://github.com/RolandStrauss/Diarium.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:time-tracker.openTimesheet",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "time-tracker.openTimesheet",
        "title": "Time Tracker: Open Timesheet"
      },
      {
        "command": "time-tracker.openTimeCard",
        "title": "Time Tracker: Preview Time Card"
      },
      {
        "command": "time-tracker.showFloatingTimer",
        "title": "Time Tracker: Show Floating Timer"
      },
      {
        "command": "time-tracker.hideFloatingTimer",
        "title": "Time Tracker: Hide Floating Timer"
      },
      {
        "command": "time-tracker.toggleTracking",
        "title": "Time Tracker: Pause / Resume File Tracking"
      },
      {
        "command": "time-tracker.manageExclusions",
        "title": "Time Tracker: Manage File Exclusions"
      },
      {
        "command": "time-tracker.resetFileTimes",
        "title": "Time Tracker: Reset File Activity"
      },
      {
        "command": "time-tracker.exportTimesheet",
        "title": "Time Tracker: Export Timesheet Data"
      },
      {
        "command": "time-tracker.importTimesheet",
        "title": "Time Tracker: Import Timesheet Data"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --external:pdfkit --minify --outfile=out/extension.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run bundle && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:optimized": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pdfkit": "^0.17.7",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  }
}
