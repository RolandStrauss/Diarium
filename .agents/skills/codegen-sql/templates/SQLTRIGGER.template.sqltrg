--
-- <Synopsis>
-- Updates a changed-row timestamp when the inbound value has not changed.
-- </Synopsis>
--
-- <Revision History>
-- Revisioner | Date | Jira No (if known) | Change |
-- R. Strauss | 2026-08-28 | N/A | Initial scaffold |
-- </Revision History>

create or replace trigger OBJECT_NAME before
update on BASE_TABLE_NAME referencing new as N old as O for each row mode db2sql begin atomic if N.UPDATED_AT = O.UPDATED_AT then
set
  N.UPDATED_AT = current timestamp;


end if;


end;


stop;
